generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ANILLO 1: IDENTIDAD
// ─────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  authIdentity      AuthIdentity?
  profile           UserProfile?
  avatar            Avatar?
  eligibilityTokens EligibilityToken[]

  @@map("users")
}

model AuthIdentity {
  id               String      @id @default(uuid())
  userId           String      @unique @map("user_id")
  contactType      ContactType @map("contact_type")
  contactHash      String      @unique @map("contact_hash")
  otpHash          String?     @map("otp_hash")
  otpExpiresAt     DateTime?   @map("otp_expires_at")
  otpAttempts      Int         @default(0) @map("otp_attempts")
  lastLoginAt      DateTime?   @map("last_login_at")
  refreshTokenHash String?     @map("refresh_token_hash")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactHash])
  @@map("auth_identities")
}

// ─────────────────────────────────────────
// ANILLO 2: PERFIL PÚBLICO
// ─────────────────────────────────────────

model Profession {
  id           String  @id @default(uuid())
  slug         String  @unique
  nameEs       String  @map("name_es")
  category     String
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  profiles UserProfile[]
  ballots  Ballot[]

  @@map("professions")
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  professionId  String?  @map("profession_id")
  setupComplete Boolean  @default(false) @map("setup_complete")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession Profession? @relation(fields: [professionId], references: [id])

  @@map("user_profiles")
}

model Avatar {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  animalSlug String   @map("animal_slug")
  colorHex   String   @map("color_hex")
  nickname   String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatars")
}

// ─────────────────────────────────────────
// ANILLO 3: VOTACIONES
// ─────────────────────────────────────────

model Poll {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  description String
  category    String
  status      PollStatus @default(DRAFT)
  startsAt    DateTime   @map("starts_at")
  endsAt      DateTime   @map("ends_at")
  isPublic    Boolean    @default(true) @map("is_public")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  options           PollOption[]
  eligibilityTokens EligibilityToken[]
  ballots           Ballot[]
  aggregatedResults AggregatedResult[]
  officialLinks     OfficialPoll[]

  @@index([status, startsAt, endsAt])
  @@map("polls")
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String   @map("poll_id")
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  poll              Poll               @relation(fields: [pollId], references: [id], onDelete: Cascade)
  ballots           Ballot[]
  aggregatedResults AggregatedResult[]

  @@index([pollId])
  @@map("poll_options")
}

model EligibilityToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  pollId    String    @map("poll_id")
  tokenHash String    @unique @map("token_hash")
  isUsed    Boolean   @default(false) @map("is_used")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@index([pollId, isUsed])
  @@map("eligibility_tokens")
}

model Ballot {
  id           String   @id @default(uuid())
  pollId       String   @map("poll_id")
  optionId     String   @map("option_id")
  tokenHash    String   @unique @map("token_hash")
  professionId String?  @map("profession_id")
  prevHash     String?  @map("prev_hash")
  ballotHash   String   @unique @map("ballot_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  poll       Poll        @relation(fields: [pollId], references: [id])
  option     PollOption  @relation(fields: [optionId], references: [id])
  profession Profession? @relation(fields: [professionId], references: [id])

  @@index([pollId])
  @@index([professionId])
  @@map("ballots")
}

model AggregatedResult {
  id           String   @id @default(uuid())
  pollId       String   @map("poll_id")
  optionId     String   @map("option_id")
  professionId String?  @map("profession_id")
  count        Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")

  poll   Poll       @relation(fields: [pollId], references: [id])
  option PollOption @relation(fields: [optionId], references: [id])

  @@unique([pollId, optionId, professionId])
  @@index([pollId])
  @@map("aggregated_results")
}

// ─────────────────────────────────────────
// FUNCIONARIOS
// ─────────────────────────────────────────

model Official {
  id          String   @id @default(uuid())
  fullName    String   @map("full_name")
  position    String
  institution String
  level       String
  state       String?
  photoUrl    String?  @map("photo_url")
  bioSummary  String?  @map("bio_summary")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pollLinks OfficialPoll[]

  @@index([level, state])
  @@map("officials")
}

model OfficialPoll {
  officialId String @map("official_id")
  pollId     String @map("poll_id")
  relation   String

  official Official @relation(fields: [officialId], references: [id])
  poll     Poll     @relation(fields: [pollId], references: [id])

  @@id([officialId, pollId])
  @@map("official_polls")
}

// ─────────────────────────────────────────
// AUDITORÍA
// ─────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  eventType  String   @map("event_type")
  actorId    String?  @map("actor_id")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ContactType {
  EMAIL
  PHONE
}

# ── Base de datos ───────────────────────────────────────
POSTGRES_USER=votar
POSTGRES_PASSWORD=votar_dev_password
POSTGRES_DB=votar_db
DATABASE_URL=postgresql://votar:votar_dev_password@localhost:5432/votar_db

# ── JWT ─────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_byte_hex_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_64_byte_hex_secret_xxxxxxxxxxxxxxxxxx
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP ─────────────────────────────────────────────────
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Eligibility tokens ──────────────────────────────────
ELIGIBILITY_TOKEN_EXPIRES_IN_MINUTES=15

# ── App ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Email (OTP por email en MVP) ────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@votar.mx

# ── Rate limiting ───────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=30
